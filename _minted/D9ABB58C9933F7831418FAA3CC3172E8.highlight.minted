\PYG{c+c1}{\PYGZsh{} function to extract features using ResNet50}
\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{extract\PYGZus{}features}\PYG{p}{(}\PYG{n}{generator}\PYG{p}{)}\PYG{p}{:}
    \PYG{n}{base\PYGZus{}model} \PYG{o}{=} \PYG{n}{ResNet50}\PYG{p}{(}\PYG{n}{weights}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+s1}{imagenet}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{,} \PYG{n}{include\PYGZus{}top}\PYG{o}{=}\PYG{k+kc}{False}\PYG{p}{,} \PYG{n}{pooling}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+s1}{avg}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{)}
    \PYG{n}{features} \PYG{o}{=} \PYG{p}{[}\PYG{p}{]}
    \PYG{n}{labels} \PYG{o}{=} \PYG{p}{[}\PYG{p}{]}

    \PYG{k}{for} \PYG{n}{batch}\PYG{p}{,} \PYG{n}{label\PYGZus{}batch} \PYG{o+ow}{in} \PYG{n}{generator}\PYG{p}{:}
        \PYG{n}{batch\PYGZus{}features} \PYG{o}{=} \PYG{n}{base\PYGZus{}model}\PYG{o}{.}\PYG{n}{predict}\PYG{p}{(}\PYG{n}{batch}\PYG{p}{)}
        \PYG{n}{features}\PYG{o}{.}\PYG{n}{extend}\PYG{p}{(}\PYG{n}{batch\PYGZus{}features}\PYG{p}{)}
        \PYG{n}{labels}\PYG{o}{.}\PYG{n}{extend}\PYG{p}{(}\PYG{n}{label\PYGZus{}batch}\PYG{p}{)}
        \PYG{k}{if} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{features}\PYG{p}{)} \PYG{o}{\PYGZgt{}}\PYG{o}{=} \PYG{n}{generator}\PYG{o}{.}\PYG{n}{samples}\PYG{p}{:}  \PYG{c+c1}{\PYGZsh{} Avoid infinite loop}
            \PYG{k}{break}
    \PYG{k}{return} \PYG{n}{np}\PYG{o}{.}\PYG{n}{array}\PYG{p}{(}\PYG{n}{features}\PYG{p}{)}\PYG{p}{,} \PYG{n}{np}\PYG{o}{.}\PYG{n}{array}\PYG{p}{(}\PYG{n}{labels}\PYG{p}{)}
